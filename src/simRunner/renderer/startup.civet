"civet coffeeCompat"

import * as gpc from './../../gpc/gui/gui.coffee'
import * as mdu from './../../meds/mdu/mdu.coffee'
import {configureBus} from './../../com/bus.civet.jsx'

ipcRenderer := window.ipcRenderer
reactClient := require 'react-dom/client';

// main-process left-edge resize tracking -> DOM event; content owners
// (the MDU canvas + debug overlays) shift right by the inset so the
// on-screen content stays put while work space opens on the left
ipcRenderer.on "cde-left-inset", (e, inset) =>
  window.dispatchEvent(new CustomEvent('cde-left-inset', {detail: inset}))

startLRUs := async (CONFIG) =>
  configureBus(CONFIG.bus) if CONFIG.bus?
  lruMap := {
    'meds/mdu/mdu': mdu
  }
  // NB: this file is coffeeCompat — `for x in arr` iterates values
  for lruName in CONFIG.thisStart
    lruConf := CONFIG.lrus[lruName]
    lruConf.NSTS_TOP = CONFIG.NSTS_TOP
    lruConf.dev = CONFIG.dev
    lruConf.dcp = CONFIG.dcp
    mod := lruMap[lruConf.module]
    if not mod?
      console.error "startup: no renderer module for #{lruConf.module} (LRU #{lruName})"
      continue
    lru := mod.default.start(lruConf)
    if lru.initWindow?
      container := document.getElementById("root")
      await reactClient.createRoot(container!).render(await lru.initWindow())
    window.lru = lru
    window.lrus ?= {}
    window.lrus[lruName] = lru
    lru.start()

ipcRenderer.on "set-config", async (e, CONFIG) =>
  if CONFIG.thisStart?
    await startLRUs(CONFIG)
  else
    // GPC debugger GUI
    debugGui := gpc.default.start(CONFIG)
    if debugGui.initWindow?
      container := document.getElementById("root")
      await reactClient.createRoot(container!).render(await debugGui.initWindow())
    window.lru = debugGui
    debugGui.start()

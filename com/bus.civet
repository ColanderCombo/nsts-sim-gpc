}

bceNumToBusConfig .= {}
for [name,config] of Object.entries(busConfig)
  if config.gpcBceNum?
    bceNumToBusConfig[config.gpcBceNum] = config
    bceNumToBusConfig[config.gpcBceNum].name = name


class BusMsg
  length16: number = 0
  rawData : Buffer
  data16 : Uint16Array = null
  data8 : Uint8Array = null
  inNetworkOrder: bool = false
  sendBuffer : Buffer

  @(@length16)
    @rawData = Buffer.alloc(@length16*2)
    @data16 = new Uint16Array(@rawData.buffer, @rawData.byteOffset, @rawData.byteLength/2)
    @data8 = new Uint8Array(@rawData.buffer, @rawData.byteOffset, @rawData.byteLength)
    @inNetworkOrder = false

  @FromNetBuf(buf)
    msg := new BusMsg(Math.ceil(buf.length/2))
    buf.copy(msg.rawData, 0, 0, msg.rawData.length)
    msg.rawData.swap16()
    return msg


  cvtToNet()
    if @inNetworkOrder == false
      @rawData.swap16()
      @inNetworkOrder = true

  cvtToLoc()
    if @inNetworkOrder 
      @rawData.swap16()
      @inNetworkOrder = false

  getBytes()
    retBuf := Buffer.from(@rawData)
    if @inNetworkOrder == false
      retBuf.swap16()
    return retBuf

class Bus
  busID : string = ''
  busDesc : string = ''
  isShuttleBus : boolean = false
  iua : number = 0
  sendBuffer : typeof Buffer = Buffer
  server : any = null
  recvCB : any = null
  cbObj : object = null
  selfEcho : any[] = []

  @(@busID, @busDesc, @isShuttleBus=false, @iua=0x00)
    @sendBuffer = Buffer.alloc(16)
    @selfEcho = []
    @_startMulticast()

  // Which interface the simulated buses live on.  Every LRU is a process on
  // this machine, so the default is loopback; NSTS_BUS_IFACE takes a local
  // address to run a bus across a real network instead.
  //
  // The interface MUST be pinned.  Joining the group without naming one
  // delivers every datagram TWICE on macOS: a sender hears two copies of its
  // own send, and so does every peer.  The self-echo filter below drops one
  // copy and passes the other, so a terminal reads its own transmission back
  // as a reply -- which desynchronises every bus program by one word.
  @IFACE = process.env.NSTS_BUS_IFACE ?? "127.0.0.1"

  _startMulticast()
    // @server = dgram.createSocket({type:"udp4", reuseAddr:true, lookup:lookup})
    @server = dgram.createSocket({type:"udp4", reuseAddr:true})
    @server.bind @busDesc.port, () =>
      @server.setBroadcast(true)
      @server.setMulticastLoopback(true)
      @server.setMulticastTTL(128)
      @server.setMulticastInterface(Bus.IFACE)
      @server.addMembership("239.255.1.1", Bus.IFACE)
      // bind: dgram invokes the handler with `this` = socket, which
      // silently orphans recvCB/busID and drops every message
      @server.on('message', (message, remote) => @_recvMessage(message, remote))
    // Don't let this socket prevent process exit
    @server.unref()

  onReceive(@recvCB, @cbObj)
    return

  @SELF_ECHO_MAX = 1024

  _isSelfEcho(message)
    for buf, i of @selfEcho
      if buf.length == message.length and buf.equals(message)
        @selfEcho.splice(i, 1)
        return true
    return false

  _noteSent(buf, len)
    @selfEcho.push Buffer.from(buf.subarray(0, len))
    @selfEcho.shift() while @selfEcho.length > Bus.SELF_ECHO_MAX
    return

  _recvMessage(message, remote)
    return if @_isSelfEcho(message)
    if @isShuttleBus
      if message[0] != @iua
        return
      message = message.slice(2)
    msg .= BusMsg.FromNetBuf(message)
    if @recvCB
      //console.log "RECV ON BUS", msg
      @recvCB(@cbObj,@busID, msg, remote)
    else
      console.log "RECV UNHANDLED", @busID, message

  send(data,len=undefined)
    return unless @server?
    len ?= data.length
    @_noteSent data, len
    @server.send data, 0, len, @busDesc.port, "239.255.1.1"

  close()
    @server?.close()
    @server = null

  sendMsg(msg)
    body := msg.getBytes()
    unless @isShuttleBus
      @send body, body.length
      return
    // dgram.send() does not copy: the buffer must be left 
    // alone until the datagram has actually gone out:
    buf := Buffer.alloc(body.length + 2)
    buf[0] = @iua
    body.copy(buf, 2)
    @send buf, buf.length

export { Bus, BusMsg, busConfig, bceNumToBusConfig };
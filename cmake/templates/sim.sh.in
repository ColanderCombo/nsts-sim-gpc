#!/bin/bash
#
# runs the simulation supervisor: starts, watches and stops the LRU
# processes that make up a configuration.
#
# Usage:
#   sim start                — the headless master
#   sim [mgr]                — open a frontend and start a master if needed
#   sim run [lru...]         — serve and start the selected LRUs
#   sim list                 — discover running simulations
#   sim catalog              — the LRUs in the configuration
#   sim config               — the configuration as sim resolved it
#   sim -r config/entry.yml  — manage a different configuration
#
# config/sim.yml is the LRU catalog (what kinds there are, how one is
# run); config/runConfig.yml is the configuration being managed.
#
# This wrapper builds nothing.  Each LRU carries a build command, which
# sim runs before starting it; --no-build skips them.
#
SRC="@NSTS_SRC_ROOT@"
PYTHON="${NSTS_SIM_PYTHON:-python3}"

for mod in yaml:pyyaml typer:typer; do
    if ! "${PYTHON}" -c "import ${mod%%:*}" >/dev/null 2>&1; then
        echo "sim: ${PYTHON} cannot import ${mod%%:*} -- try 'pip install ${mod##*:}'" >&2
        exit 1
    fi
done

exec env PYTHONPATH="${SRC}/src${PYTHONPATH:+:${PYTHONPATH}}" "${PYTHON}" -m simMgr "$@"
